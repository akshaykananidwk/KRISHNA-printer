# Krishna Printer — nginx server block.
#
# The document root is /public. Everything else — app/, config/, uploads/,
# storage/, logs/, backups/ — is outside it and unreachable over the web.

server {
    listen 80;
    server_name print.example.com;
    # Redirect everything to HTTPS. Customers upload documents and pay here.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name print.example.com;

    ssl_certificate     /etc/letsencrypt/live/print.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/print.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root /var/www/krishna-printer/public;
    index index.php;

    # Must be at least the configured maximum upload size.
    client_max_body_size 30M;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        # Updates and backups can take a while.
        fastcgi_read_timeout 600;
    }

    # Nothing under the project root but /public should ever be served, but be
    # explicit about the sensitive names in case the root is misconfigured.
    location ~ ^/(app|config|storage|uploads|logs|backups|database|routes|bin|agent|bootstrap|resources|tests)/ {
        deny all;
        return 404;
    }

    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    location = /health {
        try_files $uri /index.php?$query_string;
        access_log off;
    }
}
